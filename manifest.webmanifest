{
  "id": "./",
  "name": "VoltFleet EV Manager",
  "short_name": "VoltFleet",
  "description": "Manage an electric fleet: vehicles, charging, journeys and energy, plus charger and driver apps.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F8FAFC",
  "theme_color": "#0F766E",
  "categories": ["business", "productivity", "utilities", "travel"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Fleet dashboard", "short_name": "Dashboard", "url": "./#m-dashboard", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My vehicles", "short_name": "Vehicles", "url": "./#m-vehicles", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Charging stations", "short_name": "Stations", "url": "./#m-stations", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
